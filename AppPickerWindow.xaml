<Window x:Class="ShortcutBook.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Title="{l:T app_picker_title}" Width="460" Height="560" MinWidth="360" MinHeight="320"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="16,14,16,8">
            <TextBox x:Name="SearchBox" Style="{StaticResource PlainTextBox}" Padding="8,6" TextChanged="OnSearchChanged"
                     PreviewKeyDown="OnSearchKeyDown"/>
            <TextBlock Text="{l:T app_picker_hint}" Foreground="{DynamicResource SubText}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="16,0">
            <ListBox x:Name="AppList" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="Transparent"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="OnListDoubleClick" PreviewKeyDown="OnListKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding KindLabel}" VerticalAlignment="Center" Margin="10,0,4,0"
                                       Foreground="{DynamicResource SubText}" FontSize="11.5"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource SubText}" Text="{l:T app_picker_loading}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,14">
            <Button Content="{l:T btn_cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="OkBtn" Content="{l:T btn_select}" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
