<Window x:Class="ShortcutBook.BookmarkImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Title="{l:T bm_title}" Width="640" Height="640" MinWidth="460" MinHeight="400"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="16,14,16,8">
            <TextBlock x:Name="FileText" Foreground="{DynamicResource SubText}" TextTrimming="CharacterEllipsis"/>
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="6" Height="34" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource SubText}"
                               VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource PlainTextBox}" VerticalContentAlignment="Center" TextChanged="OnSearchChanged"/>
                    <TextBlock Grid.Column="1" Text="{l:T search_hint}" Foreground="{DynamicResource SubText}" IsHitTestVisible="False"
                               VerticalAlignment="Center" x:Name="SearchHint"/>
                </Grid>
            </Border>
            <TextBlock Text="{l:T bm_hint}" Foreground="{DynamicResource SubText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <TreeView x:Name="Tree" Grid.Row="1" Margin="16,0" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="Transparent"
                  VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource B2V}}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type l:BmNode}" ItemsSource="{Binding Children}">
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="True" Padding="4,0,0,0" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource SubText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                            <TextBlock Text="{Binding Url}" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="220"
                                       Foreground="{DynamicResource SubText}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </CheckBox>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Grid Grid.Row="2" Margin="16,10,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="{l:T bm_select_all}" Style="{StaticResource SecondaryButton}" MinWidth="0" Click="OnSelectAll"/>
                <Button Content="{l:T bm_select_none}" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="8,0,0,0" Click="OnSelectNone"/>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource SubText}"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <CheckBox x:Name="FolderCheck" Content="{l:T bm_with_folder}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:T btn_cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button x:Name="ImportBtn" Content="{l:T btn_import}" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="OnImport"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
