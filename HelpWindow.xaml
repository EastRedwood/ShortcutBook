<Window x:Class="ShortcutBook.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Title="{l:T help_title}" Width="580" SizeToContent="Height"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,18,26,18">
        <TextBlock Text="{l:T app_title}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource SubText}" Margin="0,4,0,0"/>
        <TextBlock Text="{l:T help_summary}" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <TextBlock Text="{l:T help_howto_title}" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="HowtoText" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/>

        <TextBlock Text="{l:T help_keys_title}" Style="{StaticResource SectionTitle}"/>
        <StackPanel x:Name="KeysPanel" Margin="0,8,0,0"/>

        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{l:T help_author}"/>
                <TextBlock Margin="0,6,0,0">
                    <Run Text="{l:T help_contact}"/>
                    <Hyperlink x:Name="MailLink" Click="OnMailClick"><Run x:Name="MailRun"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</Window>
