<Window x:Class="ShortcutBook.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Width="440" SizeToContent="Height"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True">
    <StackPanel Margin="22,18,22,16">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap"/>
        <TextBox x:Name="Box" Margin="0,12,0,0" Padding="4,6" VerticalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{l:T btn_cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="{l:T btn_ok}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
