<Window x:Class="ShortcutBook.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Title="{l:T edit_title}" Width="580" SizeToContent="Height"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,10,22,16">
                <!-- 아이콘 미리보기 + 이름 -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="8" Background="{DynamicResource PanelBg}" Margin="0,8,14,0" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="PreviewGlyph" Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{DynamicResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PreviewImage" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{l:T f_name}" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{l:T f_desc}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="120"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

                <!-- 실행 -->
                <TextBlock Text="{l:T sec_launch}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l:T f_target}" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" AllowDrop="True" PreviewDragOver="OnTargetDragOver" PreviewDrop="OnTargetDrop" TextChanged="OnTargetChanged"/>
                    <Button Grid.Column="1" Content="{l:T btn_file}" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="OnBrowseTargetFile"/>
                    <Button Grid.Column="2" Content="{l:T btn_folder}" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="OnBrowseTargetFolder"/>
                    <Button Grid.Column="3" Content="{l:T btn_app}" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="OnPickApp" ToolTip="{l:T btn_app_tip}"/>
                </Grid>
                <TextBlock Text="{l:T f_target_hint}" Foreground="{DynamicResource SubText}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="{l:T f_args}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ArgsBox"/>

                <TextBlock Text="{l:T f_workdir}" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkDirBox"/>
                    <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="OnBrowseWorkDir"/>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:T f_window}" VerticalAlignment="Center" Foreground="{DynamicResource SubText}" Margin="0,0,10,0"/>
                    <ComboBox x:Name="WindowCombo" Grid.Column="1" Padding="6,4"/>
                    <CheckBox x:Name="AdminCheck" Grid.Column="2" Content="{l:T f_admin}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>

                <!-- 아이콘 -->
                <TextBlock Text="{l:T sec_icon}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l:T f_icon}" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconBox" TextChanged="OnTargetChanged"/>
                    <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="OnBrowseIcon"/>
                    <Button Grid.Column="2" Content="{l:T btn_default_icon}" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="OnClearIcon"/>
                </Grid>

                <!-- 추가 옵션 -->
                <TextBlock Text="{l:T sec_extra}" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{l:T f_manual}" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ManualBox"/>
                    <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="OnBrowseManual"/>
                </Grid>

                <TextBlock Text="{l:T f_web}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="WebBox"/>

                <TextBlock Text="{l:T f_memo}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="MemoBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="140"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <Button x:Name="DeleteBtn" Content="{l:T btn_delete}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="OnDelete"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:T btn_cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="{l:T btn_save}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
