<Window x:Class="ShortcutBook.ListSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Title="{l:T listset_title}" Width="500" SizeToContent="Height"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="24,16,24,16">
        <TextBlock x:Name="ListName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="ListFile" Foreground="{DynamicResource SubText}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

        <TextBlock Text="{l:T listset_icon}" Style="{StaticResource SectionTitle}"/>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="8" Background="{DynamicResource PanelBg}" Margin="0,0,14,0" VerticalAlignment="Top">
                <Grid>
                    <TextBlock x:Name="PreviewGlyph" Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="26"
                               Foreground="{DynamicResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="PreviewImage" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconBox" VerticalContentAlignment="Center" Padding="4,5" TextChanged="OnIconChanged"/>
                    <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="OnBrowse"/>
                    <Button Grid.Column="2" Content="{l:T btn_default_icon}" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="OnClear"/>
                </Grid>
                <TextBlock Text="{l:T listset_icon_hint}" Foreground="{DynamicResource SubText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:T btn_cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="{l:T btn_save}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
