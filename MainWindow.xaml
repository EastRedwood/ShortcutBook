<Window x:Class="ShortcutBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Title="ShortcutBook" Width="760" Height="560" MinWidth="420" MinHeight="300"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop"
        PreviewKeyDown="OnWindowKeyDown" PreviewMouseDown="OnWindowMouseDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 바: 검색 · 추가 · 설정 · 정렬 · 도움말 -->
        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="6" Height="34" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource SubText}"
                                   VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource PlainTextBox}"
                                 VerticalContentAlignment="Center" TextChanged="OnSearchChanged"/>
                        <TextBlock Grid.Column="1" Text="{l:T search_hint}" Foreground="{DynamicResource SubText}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" x:Name="SearchHint"/>
                        <Button x:Name="ClearBtn" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                                Width="28" Height="28" Margin="0,0,3,0" Visibility="Collapsed" Click="OnClearSearch"/>
                    </Grid>
                </Border>

                <Button x:Name="AddBtn" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="{l:T tip_add}"
                        Click="OnAdd" AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop"/>
                <Button x:Name="SettingsBtn" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{l:T tip_settings}" Click="OnSettings"/>
                <Button x:Name="SortBtn" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8CB;" ToolTip="{l:T tip_sort}" Click="OnSort"/>
                <Button x:Name="HelpBtn" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE897;" ToolTip="{l:T tip_help}" Click="OnHelp"/>
            </Grid>
        </Border>

        <!-- 목록 -->
        <Grid Grid.Row="1">
            <ListBox x:Name="List" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     SelectionMode="Single" AllowDrop="True"
                     MouseDoubleClick="OnListDoubleClick" PreviewMouseRightButtonUp="OnListRightClick"
                     DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AllowDrop" Value="True"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type l:ItemVM}">
                        <Grid Background="Transparent" ToolTip="{Binding RowTip}">
                            <Border x:Name="MarkTop" Height="2" VerticalAlignment="Top" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                            <Border x:Name="MarkBottom" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                            <Grid Margin="{DynamicResource RowPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 끌기 손잡이 -->
                                <Border x:Name="Handle" Width="22" Background="Transparent" Cursor="SizeAll" ToolTip="{l:T tip_drag}"
                                        MouseLeftButtonDown="OnHandleDown" MouseMove="OnHandleMove" MouseLeftButtonUp="OnHandleUp">
                                    <TextBlock x:Name="HandleGlyph" Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               Foreground="{DynamicResource LineStrong}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- 아이콘 -->
                                <Grid Grid.Column="1" Width="{DynamicResource IconSize}" Height="{DynamicResource IconSize}" Margin="4,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="FallbackIcon" Text="{Binding FallbackGlyph}" FontFamily="{StaticResource IconFont}"
                                               FontSize="{DynamicResource GlyphBig}" Foreground="{DynamicResource SubText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="IconImage" Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>

                                <!-- 이름 · 설명 (빌드 #11: 설명을 이름 오른쪽에 배치. 이전 배치는 커밋 빌드 #10 참고) -->
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{DynamicResource NameColWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource NameSize}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="{DynamicResource DescSize}" Foreground="{DynamicResource SubText}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="{Binding HasDescription, Converter={StaticResource B2V}}"/>
                                </Grid>

                                <!-- 추가 옵션: 매뉴얼 · 웹 주소 · 메모 (설정한 것만 보인다) -->
                                <Border Grid.Column="3" Width="{DynamicResource ExtraWidth}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE736;" ToolTip="{Binding ManualTip}"
                                            Visibility="{Binding HasManual, Converter={StaticResource B2V}}" Click="OnManualClick"/>
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE774;" ToolTip="{Binding WebTip}"
                                            Visibility="{Binding HasWeb, Converter={StaticResource B2V}}" Click="OnWebClick"/>
                                    <Button Style="{StaticResource RowIconButton}" Content="&#xE70B;" ToolTip="{Binding MemoTip}"
                                            Visibility="{Binding HasMemo, Converter={StaticResource B2V}}" Click="OnMemoClick"/>
                                </StackPanel>
                                </Border>

                                <Button Grid.Column="4" Style="{StaticResource RowIconButton}" Content="&#xE70F;" ToolTip="{l:T tip_edit}"
                                        Margin="6,0,0,0" Click="OnEditClick"/>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding DropMark}" Value="1">
                                <Setter TargetName="MarkTop" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropMark}" Value="2">
                                <Setter TargetName="MarkBottom" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                <Setter TargetName="FallbackIcon" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Missing}" Value="True">
                                <Setter TargetName="IconImage" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="FallbackIcon" Property="Foreground" Value="{DynamicResource Danger}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanReorder}" Value="False">
                                <Setter TargetName="HandleGlyph" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="Handle" Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 비었을 때 안내 -->
            <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource SubText}" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
