<Window x:Class="ShortcutBook.MemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Width="420" Height="300" MinWidth="260" MinHeight="140"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <ScrollViewer Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="Body" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0"/>
        </ScrollViewer>
        <Button Grid.Row="2" Content="{l:T btn_close}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"/>
    </Grid>
</Window>
