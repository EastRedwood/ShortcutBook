<Window x:Class="ShortcutBook.MemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Width="420" Height="260" MinWidth="260" MinHeight="140"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnKeyDown">
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBox x:Name="Body" Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource PlainTextBox}" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
