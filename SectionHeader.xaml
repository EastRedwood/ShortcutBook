<UserControl x:Class="ShortcutBook.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <!-- 앞뒤날씨(WeatherBoard)의 ? 단추처럼 테두리가 있고 안쪽 배경이 주변보다 진한 작은 단추 -->
        <Button x:Name="HintBtn" Content="?" FontWeight="Bold" FontSize="12" Width="22" Height="22" Padding="0" Margin="8,0,0,0"
                VerticalAlignment="Center" Cursor="Hand" Focusable="False" Foreground="{DynamicResource Text}"
                Background="{DynamicResource Line}" BorderBrush="{DynamicResource LineStrong}" Click="OnHintClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Popup x:Name="HintPopup" PlacementTarget="{Binding ElementName=HintBtn}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="OnPopupClosed">
            <Border Margin="4,2,8,8" Padding="14,10" CornerRadius="6" MaxWidth="340"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource Text}"/>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
