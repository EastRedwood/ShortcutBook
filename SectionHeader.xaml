<UserControl x:Class="ShortcutBook.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <Button x:Name="HintBtn" Style="{StaticResource IconButton}" Content="&#xE897;" FontSize="13" Width="22" Height="22" Margin="6,0,0,0"
                VerticalAlignment="Center" Click="OnHintClick"/>
        <Popup x:Name="HintPopup" PlacementTarget="{Binding ElementName=HintBtn}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="OnPopupClosed">
            <Border Margin="4,2,8,8" Padding="14,10" CornerRadius="6" MaxWidth="340"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource Text}"/>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
