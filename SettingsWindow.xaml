<Window x:Class="ShortcutBook.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Title="{l:T settings_title}" Width="460" SizeToContent="Height"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,0">
    <StackPanel Margin="24,12,24,0">
        <!-- 테마 -->
        <TextBlock Text="{l:T set_theme}" Style="{StaticResource SectionTitle}" Margin="0,8,0,0"/>
        <WrapPanel Margin="0,8,0,0">
            <RadioButton x:Name="Theme0" Content="{l:T theme_system}" GroupName="theme" Margin="0,0,18,0" Checked="OnThemeChecked" Tag="0"/>
            <RadioButton x:Name="Theme1" Content="{l:T theme_light}" GroupName="theme" Margin="0,0,18,0" Checked="OnThemeChecked" Tag="1"/>
            <RadioButton x:Name="Theme2" Content="{l:T theme_dark}" GroupName="theme" Margin="0,0,18,0" Checked="OnThemeChecked" Tag="2"/>
            <RadioButton x:Name="Theme3" Content="{l:T theme_gray}" GroupName="theme" Checked="OnThemeChecked" Tag="3"/>
        </WrapPanel>

        <!-- 이름 칸 너비 -->
        <l:SectionHeader Title="{l:T set_name_width}" Hint="{l:T name_width_hint}"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="NameWidthSlider" Minimum="120" Maximum="600" SmallChange="10" LargeChange="40" TickFrequency="10"
                    IsSnapToTickEnabled="True" ValueChanged="OnNameWidthChanged"/>
            <TextBlock x:Name="NameWidthText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- 목록 크기 -->
        <l:SectionHeader Title="{l:T set_size}"/>
        <WrapPanel Margin="0,8,0,0">
            <RadioButton x:Name="Size0" Content="{l:T size_small}" GroupName="size" Margin="0,0,18,0" Checked="OnSizeChecked" Tag="0"/>
            <RadioButton x:Name="Size1" Content="{l:T size_medium}" GroupName="size" Margin="0,0,18,0" Checked="OnSizeChecked" Tag="1"/>
            <RadioButton x:Name="Size2" Content="{l:T size_large}" GroupName="size" Margin="0,0,18,0" Checked="OnSizeChecked" Tag="2"/>
            <RadioButton x:Name="Size3" Content="{l:T size_xlarge}" GroupName="size" Checked="OnSizeChecked" Tag="3"/>
        </WrapPanel>

        <!-- 다른 목록 열기 -->
        <l:SectionHeader Title="{l:T set_open_mode}" Hint="{l:T open_hint}"/>
        <StackPanel Margin="0,8,0,0">
            <RadioButton x:Name="OpenReplace" Content="{l:T open_replace}" GroupName="open" Margin="0,2" Checked="OnOpenModeChecked" Tag="0"/>
            <RadioButton x:Name="OpenNew" Content="{l:T open_new}" GroupName="open" Margin="0,2" Checked="OnOpenModeChecked" Tag="1"/>
        </StackPanel>

        <!-- 같은 대상 등록 -->
        <l:SectionHeader Title="{l:T set_dup}" Hint="{l:T dup_hint}"/>
        <StackPanel Margin="0,8,0,0">
            <RadioButton x:Name="Dup0" Content="{l:T dup_add}" GroupName="dup" Margin="0,2" Checked="OnDupChecked" Tag="0"/>
            <RadioButton x:Name="Dup1" Content="{l:T dup_skip}" GroupName="dup" Margin="0,2" Checked="OnDupChecked" Tag="1"/>
            <RadioButton x:Name="Dup2" Content="{l:T dup_overwrite}" GroupName="dup" Margin="0,2" Checked="OnDupChecked" Tag="2"/>
        </StackPanel>

        <!-- 웹 아이콘 -->
        <l:SectionHeader Title="{l:T set_web_icon}" Hint="{l:T web_icon_hint}"/>
        <CheckBox x:Name="WebIconCheck" Margin="0,8,0,0" Checked="OnWebIconToggled" Unchecked="OnWebIconToggled">
            <TextBlock Text="{l:T set_web_icon_check}" TextWrapping="Wrap"/>
        </CheckBox>

        <!-- 수정 단축키 -->
        <l:SectionHeader Title="{l:T set_edit_key}" Hint="{l:T edit_key_hint}"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="EditKeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalContentAlignment="Center" Padding="4,5"
                     PreviewKeyDown="OnEditKeyDown" ToolTip="{l:T edit_key_tip}"/>
            <Button Grid.Column="1" Content="{l:T btn_default_icon}" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="8,0,0,0" Click="OnEditKeyDefault"/>
        </Grid>

        <!-- 언어 -->
        <l:SectionHeader Title="{l:T set_language}"/>
        <ComboBox x:Name="LangCombo" Margin="0,8,0,0" Padding="6,4" SelectionChanged="OnLangChanged"/>

        <!-- 탐색기 연동 -->
        <l:SectionHeader Title="{l:T set_shell}"/>
        <CheckBox x:Name="ShellCheck" Margin="0,8,0,0" Checked="OnShellToggled" Unchecked="OnShellToggled">
            <TextBlock Text="{l:T set_shell_check}" TextWrapping="Wrap"/>
        </CheckBox>
        <TextBlock x:Name="ShellStatus" Foreground="{DynamicResource SubText}" FontSize="12" Margin="22,4,0,0" TextWrapping="Wrap"/>

        <!-- 목록 파일 폴더 -->
        <l:SectionHeader Title="{l:T set_lists_folder}" Hint="{l:T lists_folder_hint}"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ListsPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubText}"/>
            <Button Grid.Column="1" Content="{l:T btn_open_folder}" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="8,0,0,0" Click="OnOpenListsFolder"/>
        </Grid>

        <Border Height="16"/>
    </StackPanel>
    </ScrollViewer>
    </Grid>
</Window>
