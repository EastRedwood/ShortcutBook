<Window x:Class="ShortcutBook.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ShortcutBook"
        Title="ShortcutBook" Width="520" Height="440" MinWidth="380" MinHeight="320"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{l:T app_title}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="{l:T start_hint}" Foreground="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,10">
            <Button Content="{l:T btn_new_list}" Style="{StaticResource PrimaryButton}" Click="OnNew"/>
            <Button Content="{l:T btn_open_list}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnOpen"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <ListBox x:Name="RecentList" BorderBrush="{StaticResource Line}" MouseDoubleClick="OnRecentDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,5">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Folder}" Foreground="{StaticResource SubText}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoRecent" Text="{l:T start_no_recent}" Foreground="{StaticResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{l:T tip_settings}" Click="OnSettings"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE897;" ToolTip="{l:T tip_help}" Click="OnHelp"/>
        </StackPanel>
    </Grid>
</Window>
